@model List<AuditLog>
@{
    ViewData["Title"] = "Audit Log";
    int currentPage = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
    string? search = ViewBag.Search;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Audit Log</h3>
    <span class="text-muted">@ViewBag.Total records</span>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-9"><input name="search" value="@search" class="form-control" placeholder="Search by user, action or details (e.g. Leave Approved, ramesh@gmail.com)" /></div>
    <div class="col-md-1"><button class="btn btn-dark w-100">Search</button></div>
    <div class="col-md-2"><a class="btn btn-outline-secondary w-100" asp-action="Index">Reset</a></div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>Time</th><th>User</th><th>Action</th><th>Entity</th><th>Details</th><th>IP</th></tr></thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="text-nowrap">@a.Timestamp.ToString("dd MMM yyyy HH:mm:ss")</td>
                        <td>@a.UserEmail</td>
                        <td><span class="badge bg-dark">@a.Action</span></td>
                        <td>@a.Entity @(a.EntityId != null ? "#" + a.EntityId : "")</td>
                        <td>@a.Details</td>
                        <td class="text-muted small">@a.IpAddress</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No records.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3 d-flex justify-content-center align-items-center gap-3">
        @if (currentPage > 1)
        {
            <a class="btn btn-outline-dark btn-sm" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@search">Previous</a>
        }
        <span>Page @currentPage of @totalPages</span>
        @if (currentPage < totalPages)
        {
            <a class="btn btn-outline-dark btn-sm" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@search">Next</a>
        }
    </nav>
}
