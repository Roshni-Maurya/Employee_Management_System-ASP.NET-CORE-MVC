@model List<Employee>
@{ ViewData["Title"] = "Employees"; }

<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0">Employees</h3>
  <a class="btn btn-primary" asp-action="Create">+ Add Employee</a>
</div>

<form method="get" class="row g-2 mb-3">
  <div class="col-md-5"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name, code or email" /></div>
  <div class="col-md-3">
    <select name="departmentId" class="form-select" asp-items="@ViewBag.Departments"><option value="">All Departments</option></select>
  </div>
  <div class="col-md-2"><button class="btn btn-dark w-100">Filter</button></div>
  <div class="col-md-2"><a class="btn btn-outline-secondary w-100" asp-action="Index">Reset</a></div>
</form>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
  <thead><tr><th>Code</th><th>Name</th><th>Email</th><th>Department</th><th>Designation</th><th>Salary</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
  <tbody>
  @foreach (var e in Model)
  {
    <tr>
      <td>@e.EmployeeCode</td><td>@e.FullName</td><td>@e.Email</td>
      <td>@e.Department?.Name</td><td>@e.Designation</td><td>@e.Salary.ToString("N0")</td>
      <td>@if (e.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-secondary">Inactive</span> }</td>
      <td class="text-end text-nowrap">
        <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@e.Id">View</a>
        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.Id">Edit</a>
        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this employee?');">
          <input type="hidden" name="id" value="@e.Id" />
          <button class="btn btn-sm btn-outline-danger">Delete</button>
        </form>
      </td>
    </tr>
  }
  @if (!Model.Any()) { <tr><td colspan="8" class="text-center text-muted py-4">No employees found.</td></tr> }
  </tbody>
</table></div></div>
