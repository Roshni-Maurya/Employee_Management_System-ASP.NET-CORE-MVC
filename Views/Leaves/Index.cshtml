@model List<LeaveRequest>
@{ ViewData["Title"] = "Leave Requests"; string? current = ViewBag.Status; }

<h3 class="mb-3"><i class="bi bi-calendar-check me-2"></i>Leave Requests</h3>
<div class="mb-3 btn-group">
  <a class="btn btn-outline-dark @(current == null ? "active" : "")" asp-action="Index"><i class="bi bi-list-ul me-1"></i>All</a>
  <a class="btn btn-outline-dark @(current == "Pending" ? "active" : "")" asp-action="Index" asp-route-status="Pending"><i class="bi bi-hourglass-split me-1"></i>Pending</a>
  <a class="btn btn-outline-dark @(current == "Approved" ? "active" : "")" asp-action="Index" asp-route-status="Approved"><i class="bi bi-check-circle me-1"></i>Approved</a>
  <a class="btn btn-outline-dark @(current == "Rejected" ? "active" : "")" asp-action="Index" asp-route-status="Rejected"><i class="bi bi-x-circle me-1"></i>Rejected</a>
  <a class="btn btn-outline-dark @(current == "Cancelled" ? "active" : "")" asp-action="Index" asp-route-status="Cancelled"><i class="bi bi-slash-circle me-1"></i>Cancelled</a>
</div>

<div class="card"><div class="table-responsive"><table class="table align-middle mb-0">
  <thead><tr><th>Employee</th><th>Type</th><th>Dates</th><th>Days</th><th>Reason</th><th>Status</th><th>Action</th></tr></thead>
  <tbody>
  @foreach (var l in Model)
  {
    var cls = l.Status == "Approved" ? "success" : l.Status == "Rejected" ? "danger" : l.Status == "Cancelled" ? "secondary" : "warning text-dark";
    var icon = l.Status == "Approved" ? "bi-check-circle-fill" : l.Status == "Rejected" ? "bi-x-circle-fill" : l.Status == "Cancelled" ? "bi-slash-circle" : "bi-hourglass-split";
    <tr>
      <td><i class="bi bi-person-circle text-secondary me-1"></i>@l.Employee?.FullName<br /><small class="text-muted">@l.Employee?.EmployeeCode</small></td>
      <td>@l.LeaveType</td>
      <td>@l.FromDate.ToString("dd MMM") - @l.ToDate.ToString("dd MMM yyyy")</td>
      <td>@l.Days</td>
      <td>@l.Reason</td>
      <td><span class="badge bg-@cls"><i class="bi @icon me-1"></i>@l.Status</span></td>
      <td>
        @if (l.Status == "Pending")
        {
          <form asp-action="Decide" method="post" class="d-flex gap-1">
            <input type="hidden" name="id" value="@l.Id" />
            <input name="remark" class="form-control form-control-sm" placeholder="Remark" />
            <button name="status" value="Approved" class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i> Approve</button>
            <button name="status" value="Rejected" class="btn btn-sm btn-danger"><i class="bi bi-x-lg"></i> Reject</button>
          </form>
        }
        else { <small class="text-muted">@l.AdminRemark</small> }
      </td>
    </tr>
  }
  @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No leave requests.</td></tr> }
  </tbody>
</table></div></div>
