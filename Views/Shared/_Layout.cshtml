<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Employee Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <span class="navbar-brand fw-bold"><i class="bi bi-briefcase-fill me-2"></i>Employee Management</span>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Employees" asp-action="Index"><i class="bi bi-people me-1"></i>Employees</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Departments" asp-action="Index"><i class="bi bi-building me-1"></i>Departments</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Leaves" asp-action="Index"><i class="bi bi-calendar-check me-1"></i>Leaves</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Audit" asp-action="Index"><i class="bi bi-clipboard-data me-1"></i>Audit Log</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="User" asp-action="Index"><i class="bi bi-person-circle me-1"></i>My Profile</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="User" asp-action="Leaves"><i class="bi bi-calendar-check me-1"></i>My Leaves</a></li>
                    }
                </ul>
                <span class="navbar-text me-3">@User.Identity.Name (@(User.IsInRole("Admin") ? "Admin" : "Employee"))</span>
                @if (User.IsInRole("Admin"))
                {
                    <a class="btn btn-outline-light btn-sm me-2" asp-controller="Manage" asp-action="Profile"><i class="bi bi-person-gear me-1"></i>Profile</a>
                }
                <a class="btn btn-outline-light btn-sm me-2" asp-controller="Manage" asp-action="ChangePassword"><i class="bi bi-key me-1"></i>Change Password</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right me-1"></i>Logout</button>
                </form>
            </div>
        }
    </div>
</nav>

<div class="container pb-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle-fill me-1"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle-fill me-1"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @RenderBody()
</div>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
