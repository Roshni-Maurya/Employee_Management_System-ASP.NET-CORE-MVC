@model Employee?
@{ ViewData["Title"] = "My Profile"; }

@if (Model == null)
{
  <div class="alert alert-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i>Your employee record was not found. Please contact HR/Admin.</div>
}
else
{
  <h3 class="mb-3"><i class="bi bi-person-circle me-2"></i>Welcome, @Model.FullName</h3>

  @if (ViewBag.Decided != null)
  {
    foreach (LeaveRequest l in ViewBag.Decided)
    {
      var ok = l.Status == "Approved";
      <div class="alert alert-@(ok ? "success" : "danger") py-2">
        <i class="bi @(ok ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1"></i>
        Your <strong>@l.LeaveType</strong> leave (@l.FromDate.ToString("dd MMM") - @l.ToDate.ToString("dd MMM yyyy"))
        has been <strong>@(ok ? "APPROVED" : "REJECTED")</strong>.
        @if (!string.IsNullOrWhiteSpace(l.AdminRemark)) { <span> Remark: @l.AdminRemark</span> }
        <a asp-action="Leaves" class="alert-link ms-2">View</a>
      </div>
    }
  }

  <div class="row g-3">
    <div class="col-md-8">
      <div class="card shadow-sm"><div class="card-header fw-bold"><i class="bi bi-person-badge me-2"></i>My Profile</div><div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-4"><i class="bi bi-hash me-1"></i>Employee Code</dt><dd class="col-sm-8">@Model.EmployeeCode</dd>
          <dt class="col-sm-4"><i class="bi bi-envelope me-1"></i>Email</dt><dd class="col-sm-8">@Model.Email</dd>
          <dt class="col-sm-4"><i class="bi bi-telephone me-1"></i>Phone</dt><dd class="col-sm-8">@Model.Phone</dd>
          <dt class="col-sm-4"><i class="bi bi-building me-1"></i>Department</dt><dd class="col-sm-8">@Model.Department?.Name</dd>
          <dt class="col-sm-4"><i class="bi bi-briefcase me-1"></i>Designation</dt><dd class="col-sm-8">@Model.Designation</dd>
          <dt class="col-sm-4"><i class="bi bi-calendar-event me-1"></i>Joined On</dt><dd class="col-sm-8">@Model.DateOfJoining.ToString("dd MMM yyyy")</dd>
          <dt class="col-sm-4"><i class="bi bi-geo-alt me-1"></i>Address</dt><dd class="col-sm-8">@Model.Address</dd>
        </dl>
      </div></div>

      <div class="card shadow-sm mt-3">
        <div class="card-header fw-bold"><i class="bi bi-calendar2-week me-2"></i>Leave Balance (@DateTime.Today.Year)</div>
        <table class="table mb-0">
          <thead><tr><th>Type</th><th>Total</th><th>Used</th><th>Left</th></tr></thead>
          <tbody>
          @foreach (LeaveBalanceItem b in ViewBag.Balances)
          {
            <tr>
              <td>@b.Type</td><td>@b.Quota</td><td>@b.Used</td>
              <td><span class="badge bg-@(b.Remaining == 0 ? "danger" : "success")">@b.Remaining</span></td>
            </tr>
          }
          <tr><td>Unpaid</td><td colspan="3" class="text-muted"><i class="bi bi-infinity me-1"></i>No limit</td></tr>
          </tbody>
        </table>
        <div class="card-footer small text-muted"><i class="bi bi-info-circle me-1"></i>Pending and approved leaves are counted. Rejected and cancelled leaves are not.</div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-bg-warning mb-3"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="small">Pending Leaves</div><div class="fs-3 fw-bold">@ViewBag.Pending</div></div>
        <i class="bi bi-hourglass-split fs-1 opacity-75"></i></div></div>
      <div class="card text-bg-success mb-3"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="small">Approved Leaves</div><div class="fs-3 fw-bold">@ViewBag.Approved</div></div>
        <i class="bi bi-check-circle-fill fs-1 opacity-75"></i></div></div>
      <div class="card text-bg-danger mb-3"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="small">Rejected Leaves</div><div class="fs-3 fw-bold">@ViewBag.Rejected</div></div>
        <i class="bi bi-x-circle-fill fs-1 opacity-75"></i></div></div>
      <a class="btn btn-primary w-100 mb-2" asp-action="ApplyLeave"><i class="bi bi-calendar-plus me-1"></i>Apply for Leave</a>
      <a class="btn btn-outline-secondary w-100" asp-action="Leaves"><i class="bi bi-list-ul me-1"></i>My Leaves</a>
    </div>
  </div>
}
