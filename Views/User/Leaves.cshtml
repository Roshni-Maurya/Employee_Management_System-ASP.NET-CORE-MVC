@model List<LeaveRequest>
@{ ViewData["Title"] = "My Leaves"; }

<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0">My Leaves</h3>
  <a class="btn btn-primary" asp-action="ApplyLeave">+ Apply Leave</a>
</div>

<div class="card"><table class="table mb-0">
  <thead><tr><th>Type</th><th>From</th><th>To</th><th>Days</th><th>Reason</th><th>Status</th><th>Admin Remark</th></tr></thead>
  <tbody>
  @foreach (var l in Model)
  {
    var cls = l.Status == "Approved" ? "success" : l.Status == "Rejected" ? "danger" : "warning text-dark";
    <tr class="@(l.Status == "Rejected" ? "table-danger" : l.Status == "Approved" ? "table-success" : "")">
      <td>@l.LeaveType</td><td>@l.FromDate.ToString("dd MMM yyyy")</td><td>@l.ToDate.ToString("dd MMM yyyy")</td>
      <td>@l.Days</td><td>@l.Reason</td><td><span class="badge bg-@cls">@l.Status</span></td><td>@l.AdminRemark</td>
    </tr>
  }
  @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No leave requests yet.</td></tr> }
  </tbody>
</table></div>
